<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Küçültülmüş Simge -->
    <Button
        android:id="@+id/btnFloatingIcon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="#D93B2818"
        android:text="⚔️"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Ana Yüzen Kontrol Paneli -->
    <LinearLayout
        android:id="@+id/mainPanel"
        android:layout_width="285dp"
        android:layout_height="wrap_content"
        android:background="#EB2B1D12"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Sürükleme Başlığı -->
        <LinearLayout
            android:id="@+id/dragHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#4E3520"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚔️ Klanlar Tam Otomasyon"
                android:textColor="#F4E4C1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMinimize"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:background="#8C6239"
                android:padding="0dp"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5 Sekme Butonu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabMerkez"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="#6E4B2A"
                android:padding="0dp"
                android:text="Merkez"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/tabAsker"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="#4A321B"
                android:padding="0dp"
                android:text="Asker"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/tabYagma"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="#4A321B"
                android:padding="0dp"
                android:text="Yağma"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/tabBina"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="#4A321B"
                android:padding="0dp"
                android:text="Bina"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/tabTemizlik"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="#4A321B"
                android:padding="0dp"
                android:text="Temiz"
                android:textColor="#FFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 1. SEKME: MERKEZ -->
        <LinearLayout
            android:id="@+id/layoutMerkez"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Her görev arası köy ekranına dönmek için alttaki 'Oyun' simgesini tanıt:"
                android:textColor="#E6D5B8"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNoktaOyun"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:background="#8C6239"
                android:text="🎯 Alt Menü 'Oyun' İkonu Seç"
                android:textColor="#FFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTestKaydir"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:background="#5C4026"
                android:text="⬇️ Aşağı Kaydırmayı Test Et"
                android:textColor="#F4E4C1"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 2. SEKME: ASKER BASMA (KIŞLA) -->
        <LinearLayout
            android:id="@+id/layoutAsker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbAskerAktif"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Asker"
                    android:textColor="#F4E4C1"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Dk:"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etAskerDakika"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="7"
                    android:textColor="#FFF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Mızrak Adet:"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etMizrakSayisi"
                    android:layout_width="40dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="3"
                    android:textColor="#FFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNoktaKisla"
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:layout_marginTop="3dp"
                android:background="#8C6239"
                android:text="🎯 1. Köydeki Kışla Binasını Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNoktaMizrakKutu"
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:layout_marginTop="3dp"
                android:background="#8C6239"
                android:text="🎯 2. Mızrakçı Adet Kutusunu Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNoktaEgit1"
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:layout_marginTop="3dp"
                android:background="#8C6239"
                android:text="🎯 3. 'Eğit' Butonunu Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 3. SEKME: YAĞMA ASİSTANI -->
        <LinearLayout
            android:id="@+id/layoutYagma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbYagmaAktif"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Yağma"
                    android:textColor="#F4E4C1"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Dk:"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etYagmaDakika"
                    android:layout_width="34dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="5"
                    android:textColor="#FFF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Köy:"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etYagmaSayi"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="15"
                    android:textColor="#FFF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kaydır:"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etYagmaKaydirAdim"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="5"
                    android:textColor="#FFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNoktaYagmaAc"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="3dp"
                android:background="#8C6239"
                android:text="🎯 1. Yağma Asistanı Simgesini Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNoktaYagmaA"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="3dp"
                android:background="#8C6239"
                android:text="🎯 2. Yağma 'A' Butonunu Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 4. SEKME: AKILLI BİNA İNŞAATI -->
        <LinearLayout
            android:id="@+id/layoutBina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbBinaAktif"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="Bina Aktif"
                    android:textColor="#F4E4C1"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Kontrol(dk):"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etBinaDakika"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="4"
                    android:textColor="#FFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNoktaAnaBina"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:background="#8C6239"
                android:text="🎯 Köydeki Ana Binayı Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBinaOnceki"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:background="#5C4026"
                    android:padding="0dp"
                    android:text="◀"
                    android:textColor="#FFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSeciliBinaAdi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Oduncu"
                    android:textColor="#F4E4C1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBinaSonraki"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:background="#5C4026"
                    android:padding="0dp"
                    android:text="▶"
                    android:textColor="#FFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hedef Seviye:"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etBinaHedefSeviye"
                    android:layout_width="42dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="6"
                    android:textColor="#FFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnBinaSirayaEkle"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#4B7A24"
                    android:padding="0dp"
                    android:text="➕ Sıraya Ekle"
                    android:textColor="#FFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="4dp"
                android:background="#3B2716"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvBinaKuyrugu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sıra boş (Bina ve hedef seviye seçip ekle)"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />
            </ScrollView>

            <Button
                android:id="@+id/btnBinaSirasiTemizle"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:background="#7A2E24"
                android:padding="0dp"
                android:text="🗑️ İnşaat Sırasını Temizle"
                android:textColor="#FFF"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 5. SEKME: TEMİZLİK -->
        <LinearLayout
            android:id="@+id/layoutTemizlik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbTemizlikAktif"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Temizlik Aktif"
                    android:textColor="#F4E4C1"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Süre(dk):"
                    android:textColor="#E6D5B8"
                    android:textSize="10sp" />

                <EditText
                    android:id="@+id/etTemizlikDakika"
                    android:layout_width="42dp"
                    android:layout_height="32dp"
                    android:inputType="number"
                    android:text="30"
                    android:textColor="#FFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNoktaIctima"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:background="#8C6239"
                android:text="🎯 1. İçtima Meydanı Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNoktaTemizlikSekme"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:background="#8C6239"
                android:text="🎯 2. 'Temizlik' Sekmesini Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnNoktaTemizlikBaslat"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="2dp"
                android:background="#8C6239"
                android:text="🎯 3. 'Başlat' Butonunu Seç"
                android:textColor="#FFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ALT ANA KONTROL -->
        <Button
            android:id="@+id/btnBaslatDurdur"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="7dp"
            android:background="#4B7A24"
            android:text="SİSTEMİ BAŞLAT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDurum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Durum: Hazır"
            android:textColor="#C9B38C"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
